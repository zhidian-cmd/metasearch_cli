# =====================================================================
#  metasearch_cli 密钥配置（模板）
#
#  这个文件只是**模板**，不会被程序自动读取。两种正式配法：
#
#    A. 推荐 —— 用命令写入（落盘到与工作目录无关的持久文件）：
#         metasearch_cli apikey set <provider> <key>
#       持久文件位置：%AppData%\metasearch_cli\.env （Windows）
#                     ~/.config/metasearch_cli/.env （macOS/Linux）
#       查位置：metasearch_cli apikey path
#
#    B. 手工 —— 把本文件复制成 .env，放到下面任一位置（按优先级高→低）：
#         1. -env <文件> / METASEARCH_ENV_FILE
#         2. 可执行文件同目录 .env          （便携用法）
#         3. 当前工作目录 .env
#         4. %AppData%\metasearch_cli\.env  （apikey set 的写入目标）
#
#  分层合并：只填"要覆盖的"几项即可，其余仍从下层读取。
#  进程环境变量优先级高于以上全部。
#
#  ⚠️ .env 含真实密钥，已被 .gitignore 排除。
#  填了哪些 key 就启用哪些付费引擎；免费引擎（bing / anysearch / quark）无需 Key。
# =====================================================================

# Exa AI（语义搜索）
EXA_API_KEY=

# Tavily
TAVILY_API_KEY=

# AnySearch（可选：不填也可匿名使用，限流较低）
ANYSEARCH_API_KEY=

# SerpApi（Google 结果的 JSON 接口）
SERPAPI_API_KEY=

# 百度千帆 AI 搜索（百度索引）
QIANFAN_API_KEY=

# 密塔搜索 metaso.cn（官方 API，按 credits 计费）
METASO_API_KEY=
